<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FortniteInstaller.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FortniteObj" Title="oozy's Fortnite Porter — Installer beta 0.6.0" Icon="Assets/porter.ico" Width="670" Height="530" WindowStartupLocation="CenterScreen" Background="#101215" Foreground="#F4F1EC" FontFamily="Segoe UI" ResizeMode="NoResize" xmlns:fortniteinstaller="clr-namespace:FortniteInstaller">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#F4F1EC" />
        <Setter Property="Background" Value="#29211C" />
        <Setter Property="BorderBrush" Value="#69412A" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="surface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="surface" Property="Border.BorderBrush" Value="#FFB56C" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:AnimatedBackdrop />
    <Grid Margin="32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/porter.png" RenderOptions.BitmapScalingMode="HighQuality" Width="48" Height="48" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="oozy's Fortnite Porter" FontSize="23" FontWeight="SemiBold" />
          <TextBlock Text="INSTALLER  /  beta 0.6.0" FontSize="11" Foreground="#AAA09A" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,27,0,0">
        <TextBlock Name="Heading" Text="Choose where to install" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Your launcher stays in the main folder. Supporting files live in app." Foreground="#B8AEA6" Margin="0,9,0,22" />
        <TextBlock Text="Install location" FontSize="13" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Background="#17191D" BorderBrush="#494047" BorderThickness="1" CornerRadius="9">
            <TextBox Name="Folder" Background="#00FFFFFF" Foreground="#F4F1EC" CaretBrush="#FFAD72" BorderThickness="0" Padding="11" FontSize="12" VerticalContentAlignment="Center" TextChanged="FolderChanged" />
          </Border>
          <Button Name="BrowseButton" Content="Browse…" Grid.Column="1" Margin="10,0,0,0" Click="Browse" />
        </Grid>
        <Border Background="#302016" BorderBrush="#69412A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
          <TextBlock Name="Status" Text="Checking location…" Foreground="#FFD0AA" FontSize="13" />
        </Border>
      </StackPanel>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Windows x64 · .NET included" FontSize="11" Foreground="#AAA09A" VerticalAlignment="Center" />
        <Button Name="InstallButton" Content="Install" Grid.Column="1" Background="#F78B32" Foreground="#1D1008" BorderBrush="#F78B32" FontWeight="SemiBold" Padding="32,12" Click="Install" />
        <Button Name="CancelButton" Content="Cancel" Grid.Column="2" Margin="10,0,0,0" Click="Cancel" />
      </Grid>
    </Grid>
  </Grid>
</Window>