            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="Tag" Value="Close" /></MultiTrigger.Conditions><Setter TargetName="CaptionSurface" Property="Background" Value="#B73535" /></MultiTrigger>
          </ControlTemplate.Triggers>
