      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="local:UiMotion.Interactive" Value="True" />
        <Setter Property="Background" Value="#252422" />
        <Setter Property="Foreground" Value="#DEDBD5" />
        <Setter Property="BorderBrush" Value="#48443F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="MotionSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="MotionSurface" Property="Border.BorderBrush" Value="{StaticResource Orange}" />
                  <Setter TargetName="MotionSurface" Property="Border.Background" Value="#302E2B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="MotionSurface" Property="UIElement.Opacity" Value="0.75" />
