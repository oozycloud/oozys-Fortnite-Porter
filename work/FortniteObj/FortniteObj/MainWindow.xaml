                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="MotionSurface" Property="Border.BorderBrush" Value="#E8E3D8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="MotionSurface" Property="UIElement.Opacity" Value="0.35" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#DEDBD5" />
        <Setter Property="Foreground" Value="#211E1A" />
        <Setter Property="BorderBrush" Value="#DEDBD5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="14,13" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border Name="MotionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#E9D7AE" /><Setter TargetName="MotionSurface" Property="BorderBrush" Value="#E9D7AE" /><Setter Property="Foreground" Value="#211E1A" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MotionSurface" Property="BorderBrush" Value="#9C7F48" /><Setter TargetName="MotionSurface" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#C8B58D" /><Setter TargetName="MotionSurface" Property="BorderBrush" Value="#C8B58D" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionSurface" Property="Background" Value="#827E74" /><Setter TargetName="MotionSurface" Property="BorderBrush" Value="#827E74" /><Setter Property="Foreground" Value="#27241F" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#201F1E" />
        <Setter Property="Foreground" Value="#DEDBD5" />
        <Setter Property="BorderBrush" Value="#49453F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="42" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <ToggleButton Name="Toggle" Focusable="False" local:UiMotion.Interactive="True" Foreground="{TemplateBinding Control.Foreground}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Name="MotionSurface" CornerRadius="8" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Control.Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="MotionSurface" Property="Border.Background" Value="#2B2925" />
                          <Setter TargetName="MotionSurface" Property="Border.BorderBrush" Value="#BBA16A" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                          <Setter TargetName="MotionSurface" Property="Border.Background" Value="#302B23" />
                          <Setter TargetName="MotionSurface" Property="Border.BorderBrush" Value="#BBA16A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="MotionSurface" Property="UIElement.Opacity" Value="0.45" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Margin="{TemplateBinding Control.Padding}" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                    <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" Stroke="#C5B58D" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </ToggleButton>
                <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Focusable="False" PopupAnimation="{Binding DropdownAnimation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                  <Border Background="#232220" BorderBrush="#BBA16A" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer MaxHeight="330">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Toggle" Property="BorderBrush" Value="#DCD3BE" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="#E0DDD7" />
        <Setter Property="Background" Value="#232220" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="item" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="6">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                  <Setter TargetName="item" Property="Border.Background" Value="#37322A" />
                  <Setter Property="Foreground" Value="#E3DAC6" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="item" Property="Border.Background" Value="#494133" />
                  <Setter Property="Foreground" Value="#F0EBE0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="#BDB7AE" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="choice" Background="#1E1E1D" BorderBrush="#48443F" BorderThickness="1" Padding="{TemplateBinding Control.Padding}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="choice" Property="Border.Background" Value="#373229" />
                  <Setter TargetName="choice" Property="Border.BorderBrush" Value="{StaticResource Orange}" />
                  <Setter Property="Foreground" Value="#E3D9C2" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="choice" Property="Border.BorderBrush" Value="#E8E3D8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
