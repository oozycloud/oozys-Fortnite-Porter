        <Setter Property="Foreground" Value="#DEDBD5" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="item" Background="#00FFFFFF" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="item" Property="Border.Background" Value="#2B2925" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="item" Property="Border.Background" Value="#423A2D" />
                  <Setter Property="Foreground" Value="#E2D9C6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#DEDBD5" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Control.Padding}">
                <Border Name="switch" Width="30" Height="18" CornerRadius="9" Background="#3A3732" BorderBrush="#746C60" BorderThickness="1" VerticalAlignment="Center">
                  <Ellipse Name="dot" Width="12" Height="12" Fill="#C9C4BB" HorizontalAlignment="Left" Margin="2,0" />
                </Border>
                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="switch" Property="Border.Background" Value="#8C7952" />
                  <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="dot" Property="Shape.Fill" Value="#E2D8BF" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="switch" Property="Border.BorderBrush" Value="#CCBA91" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="switch" Property="Border.BorderBrush" Value="#E2D8BF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Track Name="PART_Track" Orientation="{TemplateBinding ScrollBar.Orientation}" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Name="before" Command="ScrollBar.PageUpCommand" Focusable="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border Name="grip" Background="#4B4640" CornerRadius="5" Margin="2" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="grip" Property="Border.Background" Value="#80745F" />
                            </Trigger>
                            <Trigger Property="Thumb.IsDragging" Value="True">
                              <Setter TargetName="grip" Property="Border.Background" Value="#A68F62" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Name="after" Command="ScrollBar.PageDownCommand" Focusable="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
                  <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
                  <Setter TargetName="before" Property="ButtonBase.Command" Value="ScrollBar.PageLeftCommand" />
                  <Setter TargetName="after" Property="ButtonBase.Command" Value="ScrollBar.PageRightCommand" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
            <Setter Property="Height" Value="12" />
            <Setter Property="Width" Value="Auto" />
          </Trigger>
        </Style.Triggers>
      </Style>
