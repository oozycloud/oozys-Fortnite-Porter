            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#D2BF96" /><Setter TargetName="TabSurface" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Opacity" Value="0.7" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabSurface" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
