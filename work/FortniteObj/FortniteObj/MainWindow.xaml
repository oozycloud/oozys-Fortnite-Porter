          <Border BorderBrush="#36332D" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="YOUR SELECTION" FontSize="10" FontWeight="Bold" Foreground="#BDAE8A" /><TextBlock Text="Export asset" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
              <Button Name="CloseOverlayButton" Grid.Column="1" Content="← Back to library" VerticalAlignment="Center" Padding="14,10" Click="CloseAssetOverlay_Click" ToolTip="Close this export view (Esc)" AutomationProperties.Name="Back to model library" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="326" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#36332D" BorderThickness="0,0,1,0" Padding="24,0,24,20">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <Border Background="#25231F" BorderBrush="#39362F" BorderThickness="1" CornerRadius="14" Height="286">
                    <Grid>
                      <local:AssetThumbnail x:Name="OverlayThumbnail" Margin="16" />
                      <TextBlock Text="{Binding Status, ElementName=OverlayThumbnail}" FontSize="13" Foreground="#B4ADA0" LineHeight="21" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="210" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status, ElementName=OverlayThumbnail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                  <TextBlock Name="OverlayAssetName" Text="Your selected model" FontSize="25" FontWeight="SemiBold" Margin="0,20,0,8" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Asset.Category, ElementName=OverlayThumbnail}" Foreground="#C5B48D" FontSize="13" />
                  <TextBlock Name="OverlayAssetId" Foreground="#A9A296" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                  <Border BorderBrush="#37332C" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,15,0,0"><TextBlock Text="Choose the style and export settings on the right. Your library stays right where you left it." Foreground="#AAA399" FontSize="12" LineHeight="20" /></Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
<Border Name="InspectorShell" Grid.Column="1" Background="Transparent" BorderThickness="0" CornerRadius="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer Name="InspectorScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="InspectorPanel" Margin="26,10,26,18">
              <TextBlock Text="EXPORT OPTIONS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource OrangeLight}" />
              <TextBlock Text="Export settings" FontSize="24" FontWeight="SemiBold" Margin="0,1,0,4" />

              <TextBlock Name="ModeHint" Text="Select one or more assets from the library." Foreground="{StaticResource Muted}" LineHeight="20" FontSize="13" Margin="0,13,0,18" />
              <StackPanel Name="AssetDetailsPanel">
                <TextBlock Text="SELECTED ASSETS" Style="{StaticResource Eyebrow}" />
                <TextBlock Name="SelectionTitle" Text="Nothing selected" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,5" />
                <TextBlock Name="AssetSource" Text="Choose an item from the library." Foreground="#AAA69F" FontSize="12" />
              </StackPanel>

              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,18" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="StyleLabel" Text="STYLE" Style="{StaticResource Eyebrow}" Margin="0,0,0,0" />
                <TextBlock Name="StyleCount" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource OrangeLight}" />
              </Grid>
              <ComboBox Name="StyleSelector" Margin="0,9,0,0" SelectionChanged="Style_Changed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Image Width="28" Height="28" Stretch="UniformToFill" Margin="0,0,9,0" Source="{Binding ImageUrl}" />
                      <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <TabControl Name="StyleChannelsTab" Visibility="Collapsed" Background="#00FFFFFF" BorderThickness="0" Margin="0,9,0,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </TabControl>
              <TextBlock Name="StyleHint" Text="Choose an asset to load its styles." Foreground="#AAA69F" FontSize="12" LineHeight="19" Margin="0,9,0,0" />
              <StackPanel Name="RocketAppearancePanel" Visibility="Collapsed" Margin="0,14,0,0" />
              <StackPanel Name="EmoteStylePanel" Visibility="Collapsed" Margin="0,16,0,6">
                <TextBlock Text="EMOTE STYLE" Style="{StaticResource Eyebrow}" />
                <ComboBox Name="EmoteStyleSelector" ToolTip="Traversal uses the moving clip. Static traversal uses the stationary clip. This choice belongs to the selected emote." SelectionChanged="EmoteStyle_Changed" />
              </StackPanel>
              <CheckBox Name="SavePng" Content="Save preview PNG" Margin="0,12,0,0" ToolTip="Save the selected style’s source icon beside the export." />
              <CheckBox Name="VehicleTemplates" Content="Labelled vehicle texture templates (.png)" IsChecked="True" Margin="0,12,0,0" Visibility="Collapsed" ToolTip="Save 2048px UV wire guides and labelled reference PNGs for every vehicle material. Includes an island-to-mesh index for custom painting." Checked="Appearance_Changed" Unchecked="Appearance_Changed" />

              <TextBlock Text="FILE FORMAT" Style="{StaticResource Eyebrow}" Margin="0,20,0,7" />
              <ComboBox Name="OverlayExportFormat" SelectedIndex="{Binding SelectedIndex, ElementName=ExportFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export file format">
                <ComboBoxItem Content="Packed Blender (.blend)" />
                <ComboBoxItem Content="Blender + OBJ source files" />
                <ComboBoxItem Content="GLB + Blender" />
                <ComboBoxItem Content="glTF + Blender" />
                <ComboBoxItem Content="FBX + Blender" />
                <ComboBoxItem Content="OBJ + Blender" />
                <ComboBoxItem Content="STL + Blender" />
              </ComboBox>
              <TextBlock Text="SAVE TO" Style="{StaticResource Eyebrow}" Margin="0,18,0,6" />
              <TextBlock Text="{Binding Text, ElementName=ExportPath}" Foreground="#C7C0B4" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, ElementName=ExportPath}" />
              <Border Background="#25231F" BorderBrush="#494135" BorderThickness="1" Padding="12" Margin="0,20,0,0" CornerRadius="9">
                <StackPanel>
                  <TextBlock Text="OUTPUT" Foreground="{StaticResource OrangeLight}" FontSize="11" FontWeight="Bold" />
                  <TextBlock Name="OutputFormatHint" Text="One .blend containing the model, textures, rig and animation." Foreground="#CBC4B7" FontSize="12" LineHeight="19" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,16">
            <StackPanel>

              <Button Name="ExportButton" Content="Export asset →" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="Export_Click" />
              <ProgressBar Name="OverlayActivity" Height="4" Margin="0,8,0,0" Value="{Binding Value, ElementName=Activity}" Minimum="{Binding Minimum, ElementName=Activity}" Maximum="{Binding Maximum, ElementName=Activity}" IsIndeterminate="{Binding IsIndeterminate, ElementName=Activity}" Visibility="{Binding Visibility, ElementName=CancelButton}" Foreground="{StaticResource Orange}" Background="#302C24" BorderThickness="0" AutomationProperties.Name="Export progress" />
              <TextBlock Name="OverlayProgressText" Text="{Binding Text, ElementName=ProgressText}" Visibility="{Binding Visibility, ElementName=CancelButton}" Foreground="#BDB7AE" FontSize="11" LineHeight="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              <Button Name="CancelButton" Content="Cancel operation" Visibility="Collapsed" Padding="10,7" FontSize="12" Margin="0,8,0,0" Click="Cancel_Click" />
              <Button Name="OpenFolderButton" Content="Open export folder ↗" Background="#00FFFFFF" BorderThickness="0" FontSize="12" Foreground="#BDB7AE" Margin="0,6,0,0" Padding="8,7" Click="OpenFolder_Click" />
              <Button Content="Open session log ↗" Background="#00FFFFFF" BorderThickness="0" FontSize="12" Foreground="#BDB7AE" Padding="8,5" Click="Log_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Name="LegacySceneControls" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
              <StackPanel Orientation="Horizontal">
                <RadioButton Name="SingleMode" Content="Single asset" IsChecked="True" GroupName="ExportMode" FontSize="13" Checked="Mode_Changed" />
                <RadioButton Name="SceneMode" Content="Skin + emote" GroupName="ExportMode" FontSize="13" Checked="Mode_Changed" />
                <Button Content="i" Style="{StaticResource InfoButton}" ToolTip="Select a model card to configure its export." />
              </StackPanel>
<StackPanel Name="SceneSlots" Visibility="Collapsed" Margin="0,12,0,0">
                <Border Background="#1A1A19" BorderBrush="#494135" BorderThickness="1" Padding="12" CornerRadius="9">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="SKINS TO EXPORT" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Choose skins" Padding="9,6" FontSize="11" Click="ChooseSkin_Click" />
                    </Grid>
                    <ListBox Name="SceneSkinsList" SelectionMode="Extended" Height="108" Margin="0,5,0,0" DisplayMemberPath="Name" SelectionChanged="SceneSelection_Changed" />
                    <TextBlock Name="SceneSkinLabel" Text="Nothing selected" FontSize="12" Foreground="#BDB5A8" Margin="0,7,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#1A1A19" BorderBrush="#494135" BorderThickness="1" Padding="12" CornerRadius="9" Margin="0,9,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="EMOTES TO EXPORT" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Choose emotes" Padding="9,6" FontSize="11" Click="ChooseEmote_Click" />
                    </Grid>
                    <ListBox Name="SceneEmotesList" SelectionMode="Extended" Height="108" Margin="0,5,0,0" DisplayMemberPath="Name" SelectionChanged="SceneSelection_Changed" />
                    <TextBlock Name="SceneEmoteLabel" Text="Nothing selected" FontSize="12" Foreground="#BDB5A8" Margin="0,7,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
<StackPanel Name="SceneNamePanel" Visibility="Collapsed" Margin="0,20,0,0">
                <TextBlock Text="SCENE NAME" Style="{StaticResource Eyebrow}" />
                <TextBox Name="SceneName" Text="Fortnite_Scene" Margin="0,9,0,0" />
              </StackPanel>
    </StackPanel>
    <ContentControl Name="StudioHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
