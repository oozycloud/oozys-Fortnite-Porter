        <Setter Property="Padding" Value="17,12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="tab" BorderBrush="#00FFFFFF" BorderThickness="0,0,0,2" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter ContentSource="Header" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="tab" Property="Border.BorderBrush" Value="{StaticResource Orange}" />
                  <Setter Property="Foreground" Value="#DED5BF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#252422" />
        <Setter Property="Foreground" Value="#BAB5AC" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
