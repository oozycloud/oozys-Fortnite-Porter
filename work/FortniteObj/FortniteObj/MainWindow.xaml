<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FortniteObj.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FortniteObj" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="None" Title="oozy's porter studio beta 0.12.0" Icon="Assets/porter.ico" Width="1500" Height="960" MinWidth="1220" MinHeight="760" Background="#121212" Foreground="#DEDBD5" FontFamily="pack://application:,,,/assets/#Manrope" FontSize="14" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
